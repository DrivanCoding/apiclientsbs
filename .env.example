# ==============================================================
# PAYNOTE ORANGE MONEY - ANCIENNE API DIRECTE
# Configuration actuellement utilisee
# ==============================================================

# Active Paynote comme passerelle de paiement.
MYAPIOPERATOR=paynote

    # Garde Orange sur l'ancienne methode directe.
    PAYNOTE_ORANGE_MODE=legacy
    PAYNOTE_ORANGE_DIRECT_API_BASE=https://api-s1.orange.cm

    # Anciens identifiants Orange utilises pour generer le Bearer token.
    # Mettre les anciens username/password du contrat Orange.
    PAYNOTE_ORANGE_CUSTOMER_KEY=
    PAYNOTE_ORANGE_CUSTOMER_SECRET=

    # Identifiants du meme ancien contrat marchand Orange.
    PAYNOTE_ORANGE_X_AUTH_TOKEN=
    PAYNOTE_ORANGE_CHANNEL_USER_MSISDN=
    PAYNOTE_ORANGE_PIN=REMPLACER_PAR_PIN_SIM_MARCHANDE

    # URL publique appelee par Orange lors de la confirmation du paiement.
    PAYNOTE_ORANGE_NOTIF_URL=https://testsmooth.mifide.com/api/paynote/webhook

    # Secret prive ajoute automatiquement a l'URL du webhook.
    PAYNOTE_WEBHOOK_SECRET=IUUUJDUJUJDU9J9*ZODUJZU9SJH8AJ8SJ727SHUujuJ87Jèh7hèHJususyH7hqèjyèHJJUçjuJj*

    # Delai et limites des paiements Orange.
    PAYNOTE_ORANGE_TIMEOUT_MS=15000
    PAYNOTE_ORANGE_MIN_AMOUNT=10
    PAYNOTE_ORANGE_MAX_AMOUNT=500000

    # Verification immediate du statut apres la demande de paiement.
    PAYNOTE_STATUS_POLL_ATTEMPTS=25
    PAYNOTE_STATUS_POLL_DELAY_MS=3000

    # Verification automatique des paiements restes en attente.
    PAYNOTE_BACKGROUND_VERIFY_ENABLED=true
    PAYNOTE_VERIFY_INTERVAL_SECONDS=15
    PAYNOTE_VERIFY_WINDOW_HOURS=24
    PAYNOTE_VERIFY_BATCH_SIZE=20
