# Base de donnees
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=clientsbs

# Fournisseur SMS partage par tous les parcours SBSClient
SMS_PROVIDER=mtarget

# MTarget (username/password obligatoires, serviceid et sender optionnels)
MTARGET_USERNAME=
MTARGET_PASSWORD=
MTARGET_SERVICE_ID=
MTARGET_BASE_URL=https://api-public-2.mtarget.fr/messages
MTARGET_DEFAULT_SENDER=
MTARGET_TIMEOUT_MS=45000

# Compatibilite: si MTARGET_USERNAME/PASSWORD sont vides, le service peut lire
# SMS_USER/SMS_PASSWORD deja presents dans un ancien deploiement.
SMS_USER=
SMS_PASSWORD=

# Passerelle de paiement active: paynote ou maviance
MYAPIOPERATOR=maviance

# Paynote mutualise Orange Money / MTN Mobile Money
PAYNOTE_ORANGE_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
PAYNOTE_ORANGE_API_BASE=https://omapi.ynote.africa/prod
PAYNOTE_ORANGE_CUSTOMER_KEY=
PAYNOTE_ORANGE_CUSTOMER_SECRET=
PAYNOTE_ORANGE_PAYMENT_METHOD=OM_CMR
PAYNOTE_ORANGE_STATUS_PATH=/webpayment/status
PAYNOTE_ORANGE_TIMEOUT_MS=15000

PAYNOTE_MTN_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
PAYNOTE_MTN_API_BASE=https://omapi.ynote.africa/prod
PAYNOTE_MTN_CUSTOMER_KEY=
PAYNOTE_MTN_CUSTOMER_SECRET=
PAYNOTE_MTN_TOKEN_CLIENT_ID=
PAYNOTE_MTN_TOKEN_CLIENT_SECRET=
PAYNOTE_MTN_PAYMENT_METHOD=MTN_CMR
PAYNOTE_MTN_STATUS_PATH=/webpaymentmtn/status
PAYNOTE_MTN_TIMEOUT_MS=15000

# URL HTTPS publique du webhook. L'API ajoute automatiquement le secret dans
# le parametre query `token` avant d'envoyer l'URL a Paynote.
# Exemple: https://api.example.tld/api/paynote/webhook
PAYNOTE_NOTIF_URL=
PAYNOTE_WEBHOOK_SECRET=
PAYNOTE_STATUS_POLL_ATTEMPTS=25
PAYNOTE_STATUS_POLL_DELAY_MS=3000
