# ==============================================================================
# SBS CLIENT API - VARIABLES D'ENVIRONNEMENT
# ==============================================================================
# Copiez ce fichier vers `.env`, puis remplacez toutes les valeurs `change-me`.
# Ne commitez jamais le fichier `.env` ni de vrais secrets.
#
# Les sections marquees REQUIS sont necessaires au fonctionnement de base.
# Les autres sections ne sont requises que si la fonctionnalite est activee.

# ==============================================================================
# 1. APPLICATION [REQUIS]
# Parametres generaux du serveur NestJS et origine autorisee pour Socket.IO.
# ==============================================================================
NODE_ENV=development
PORT=3500

# URL du back-office autorise a se connecter aux notifications temps reel.
# FRONTEND_URL est un ancien alias utilise si ADMIN_APP_ORIGIN est absent.
ADMIN_APP_ORIGIN=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# ==============================================================================
# 2. BASE DE DONNEES MYSQL [REQUIS]
# Connexion MySQL utilisee par l'API et par les migrations TypeORM.
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=clientsbs

# Active les requetes SQL dans les journaux TypeORM (true/false).
TYPEORM_LOGGING=false

# ==============================================================================
# 3. AUTHENTIFICATION JWT [REQUIS]
# Secret de signature et duree de validite des jetons d'acces.
# Utilisez un secret aleatoire long et different dans chaque environnement.
# ==============================================================================
JWT_ACCESS_SECRET=change-me-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d

# Ancien alias, lu uniquement si JWT_ACCESS_SECRET est absent.
# JWT_SECRET=change-me-with-a-long-random-secret

# ==============================================================================
# 4. E-MAIL SMTP [OPTIONNEL]
# Envoi des codes OTP de configuration du PIN par e-mail.
# Sans configuration SMTP, l'OTP est affiche dans la console en developpement.
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
SMTP_FROM=no-reply@example.com
SMTP_SECURE=false

# ==============================================================================
# 5. CORE BANKING ET SYNCHRONISATION [OPTIONNEL]
# Acces aux releves PDF du core banking et protection des appels de synchronisation.
# ==============================================================================
CORE_BANKING_BASE_URL=https://smooth-banksoft.mifide.com/
CORE_BANKING_JWT_SECRET=j7DJqk9ksdk_e_sk_z_jd_z_8K0Q@@Q1@3JQjhg/js*jqqjuiojuhuLU
CORE_BANKING_JWT_ISSUER=sbsclient
CORE_BANKING_JWT_AUDIENCE=collectapp
CORE_BANKING_TIMEOUT_MS=20000

# Ancien alias de CORE_BANKING_JWT_SECRET.
# SBS_JWT_SECRET=change-me-with-a-long-random-secret

# Token attendu dans l'en-tete `x-server-sync-token` des appels du core banking.
CORE_SYNC_TOKEN=change-me-with-a-long-random-secret

# Ancien alias de CORE_SYNC_TOKEN.
# SBSCLIENT_CORE_SYNC_TOKEN=change-me-with-a-long-random-secret

# ==============================================================================
# 6. SMS [OPTIONNEL]
# Fournisseur utilise pour les SMS : disabled, mtarget ou ebs.
# Les variables SMS_* servent de valeurs communes de secours aux fournisseurs.
# ==============================================================================
SMS_PROVIDER=disabled
# SMS_USER=
# SMS_PASSWORD=
# SMS_SENDER_ID=SBS
# SMS_API_URL=

# --- MTarget (requis lorsque SMS_PROVIDER=mtarget) -----------------------------
MTARGET_USERNAME=
MTARGET_PASSWORD=
MTARGET_SERVICE_ID=
MTARGET_DEFAULT_SENDER=SBS
MTARGET_BASE_URL=https://api-public-2.mtarget.fr/messages
MTARGET_TIMEOUT_MS=45000

# Ancien alias de MTARGET_DEFAULT_SENDER.
# MTARGET_SENDER=SBS

# --- EBS237 (requis lorsque SMS_PROVIDER=ebs) ----------------------------------
EBS_SMS_USER=
EBS_SMS_PASSWORD=
EBS_SMS_SENDER_ID=SBS
EBS_SMS_API_URL=https://sms.ebs237.online/smsapi/sendSMS

# ==============================================================================
# 7. PASSERELLE DE PAIEMENT [REQUIS POUR LES PAIEMENTS MOBILES]
# Selectionne l'integration active : maviance ou paynote.
# Configurez ensuite uniquement la section correspondant a votre choix.
# ==============================================================================
MYAPIOPERATOR=maviance

# ==============================================================================
# 8. MAVIANCE S3P [REQUIS SI MYAPIOPERATOR=maviance]
# Identifiants, URL S3P, pay items et verification des transactions Maviance.
# ==============================================================================
MAVIANCE_ENV=staging
MAVIANCE_BASE_URL=https://s3p.smobilpay.staging.maviance.info/v2
MAVIANCE_PUBLIC_TOKEN=
MAVIANCE_ACCESS_SECRET=
MAVIANCE_HTTP_TIMEOUT=30

# Pay item par operateur. La valeur par defaut est utilisee si celle de
# l'operateur est absente.
MAVIANCE_PAYITEM_OM=
MAVIANCE_PAYITEM_MOMO=
MAVIANCE_DEFAULT_PAY_ITEM_ID=

# Verification immediate apres une demande de paiement.
MAVIANCE_STATUS_POLL_ATTEMPTS=20
MAVIANCE_STATUS_POLL_DELAY_MS=3000

# Verification periodique des transactions encore en attente.
MAVIANCE_BACKGROUND_VERIFY_ENABLED=false
MAVIANCE_VERIFY_INTERVAL_SECONDS=10
MAVIANCE_MASTER_DATA_CACHE_TTL=86400

# Numeros de test facultatifs pour l'environnement sandbox.
MAVIANCE_SANDBOX_USE_TEST_NUMBERS=false
MAVIANCE_SANDBOX_OM_CUSTOMER_PHONE=
MAVIANCE_SANDBOX_OM_SERVICE_NUMBER=
MAVIANCE_SANDBOX_MOMO_CUSTOMER_PHONE=
MAVIANCE_SANDBOX_MOMO_SERVICE_NUMBER=

# ==============================================================================
# 9. PAYNOTE - PARAMETRES COMMUNS [REQUIS SI MYAPIOPERATOR=paynote]
# Webhook, delais et verification des paiements Orange Money et MTN MoMo.
# Les reglages propres a chaque operateur se trouvent dans les sections suivantes.
# ==============================================================================
PAYNOTE_WEBHOOK_SECRET=change-me-with-a-long-random-secret
PAYNOTE_TIMEOUT_MS=90000
PAYNOTE_STATUS_POLL_ATTEMPTS=60
PAYNOTE_STATUS_POLL_DELAY_MS=3000

# Reconciliation periodique des transactions restees en attente.
PAYNOTE_BACKGROUND_VERIFY_ENABLED=true
PAYNOTE_VERIFY_INTERVAL_SECONDS=15
PAYNOTE_VERIFY_WINDOW_HOURS=24
PAYNOTE_VERIFY_BATCH_SIZE=20

# Valeurs generiques de secours, utiles si Orange et MTN partagent le meme contrat.
# Les valeurs propres a un operateur ont priorite sur celles-ci.
PAYNOTE_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
PAYNOTE_API_BASE=https://omapi.ynote.africa/prod
PAYNOTE_CLIENT_ID=
PAYNOTE_CLIENT_SECRET=
PAYNOTE_CUSTOMER_KEY=
PAYNOTE_CUSTOMER_SECRET=
PAYNOTE_NOTIF_URL=https://api.example.com/api/paynote/webhook
PAYNOTE_PAYMENT_METHOD=OM_CMR
PAYNOTE_STATUS_PATH=/webpayment/status

# Anciens alias des parametres mutualises.
# PAYNOTE_MUTUALIZED_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
# PAYNOTE_MUTUALIZED_API_BASE=https://omapi.ynote.africa/prod
# PAYNOTE_MUTUALIZED_CLIENT_ID=
# PAYNOTE_MUTUALIZED_CLIENT_SECRET=

# ==============================================================================
# 10. PAYNOTE ORANGE MONEY [SI ORANGE MONEY EST ACTIVE]
# `mutualized` utilise l'API Paynote unifiee ; `legacy` utilise l'ancienne API
# Orange directe. Les identifiants des deux modes sont differents.
# ==============================================================================
PAYNOTE_ORANGE_MODE=mutualized

# --- Mode mutualized ----------------------------------------------------------
PAYNOTE_ORANGE_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
PAYNOTE_ORANGE_TOKEN_CLIENT_ID=
PAYNOTE_ORANGE_TOKEN_CLIENT_SECRET=
PAYNOTE_ORANGE_API_BASE=https://omapi.ynote.africa/prod
PAYNOTE_ORANGE_CUSTOMER_KEY=
PAYNOTE_ORANGE_CUSTOMER_SECRET=
PAYNOTE_ORANGE_NOTIF_URL=https://api.example.com/api/paynote/webhook
PAYNOTE_ORANGE_PAYMENT_METHOD=OM_CMR
PAYNOTE_ORANGE_STATUS_PATH=/webpayment/status
PAYNOTE_ORANGE_TIMEOUT_MS=90000
PAYNOTE_ORANGE_MIN_AMOUNT=10
PAYNOTE_ORANGE_MAX_AMOUNT=500000

# --- Mode legacy uniquement ---------------------------------------------------
PAYNOTE_ORANGE_DIRECT_API_BASE=https://api-s1.orange.cm
PAYNOTE_ORANGE_X_AUTH_TOKEN=
PAYNOTE_ORANGE_CHANNEL_USER_MSISDN=
PAYNOTE_ORANGE_PIN=

# En mode legacy, PAYNOTE_ORANGE_CUSTOMER_KEY et
# PAYNOTE_ORANGE_CUSTOMER_SECRET correspondent aux anciens identifiants Orange
# servant a generer le Bearer token.

# ==============================================================================
# 11. PAYNOTE MTN MOMO [SI MTN MOMO EST ACTIF]
# Identifiants et routes de l'API Paynote mutualisee pour MTN Mobile Money.
# ==============================================================================
PAYNOTE_MTN_TOKEN_URL=https://omapi-token.ynote.africa/oauth2/token
PAYNOTE_MTN_TOKEN_CLIENT_ID=
PAYNOTE_MTN_TOKEN_CLIENT_SECRET=
PAYNOTE_MTN_API_BASE=https://omapi.ynote.africa/prod
PAYNOTE_MTN_CUSTOMER_KEY=
PAYNOTE_MTN_CUSTOMER_SECRET=
PAYNOTE_MTN_NOTIF_URL=https://api.example.com/api/paynote/webhook
PAYNOTE_MTN_PAYMENT_METHOD=MTN_CMR
PAYNOTE_MTN_STATUS_PATH=/webpaymentmtn/status
PAYNOTE_MTN_TIMEOUT_MS=90000
PAYNOTE_MTN_MIN_AMOUNT=10
PAYNOTE_MTN_MAX_AMOUNT=500000
